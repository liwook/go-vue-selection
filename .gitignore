# ===================== 依赖 / 构建产物 =====================
# Node / pnpm
node_modules/
dist/
dist-ssr/
*.local
.pnpm-store/

# Go
# 编译产物（go build 输出）
*.exe
*.exe~
*.dll
*.so
*.dylib
# 测试与性能分析产物
*.test
*.out
coverage.out
# Go workspace 文件
go.work
go.work.sum

# ===================== 环境变量 / 密钥 =====================
.env
.env.*
!.env.example

# ===================== 配置文件（仅模板入库，真实配置忽略） =====================
# 模板用 config.yaml.example，本地/生产真实配置 config.yaml 不入库
apps/server/etc/config.yaml

# 集成测试上传产物（文件上传用例生成的 static 目录）
apps/server/tests/static/

# ===================== 编辑器 / 系统 =====================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ===================== 日志 =====================
*.log
npm-debug.log*
pnpm-debug.log*

# ===================== 工具缓存 =====================
# golangci-lint 缓存
.golangci-cache/
# lefthook 临时
.lf*

# ===================== IDE / 工具数据 =====================
# CodeBuddy 内部数据目录
.codebuddy/
