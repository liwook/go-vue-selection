# ---- PostgreSQL 密码 ----
# 1) POSTGRES_PASSWORD：pg 容器专用，用于首次启动初始化数据库用户/库（postgres 官方镜像约定变量名）
POSTGRES_PASSWORD=CHANGE_ME
# 2) VUE_ADMIN_POSTGRES_PASSWORD：backend 连库实际读取的密码（后端 viper 前缀 VUE_ADMIN，
#    读取配置项 postgres.password，对应环境变量 VUE_ADMIN_POSTGRES_PASSWORD）。
#    两项值必须一致，但变量名不同，pg 容器与 backend 各取所需，缺一不可。
VUE_ADMIN_POSTGRES_PASSWORD=CHANGE_ME

# ---- JWT 签名密钥 ----
# 1) AUTH_JWT_SECRET：供参考/兼容，非后端实际读取项（已弃用，保留方便比对）
AUTH_JWT_SECRET=CHANGE_ME_REPLACE_WITH_STRONG_RANDOM
# 2) VUE_ADMIN_AUTH_JWT_SECRET：backend 实际读取的 JWT 签名密钥（viper 读取 auth.jwt_secret，
#    对应环境变量 VUE_ADMIN_AUTH_JWT_SECRET）。请替换为强随机值，例如：openssl rand -hex 32
VUE_ADMIN_AUTH_JWT_SECRET=CHANGE_ME_REPLACE_WITH_STRONG_RANDOM
