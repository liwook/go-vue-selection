{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vue-tsc -b && vite build",
    "build:test": "vue-tsc -b && vite build --mode test",
    "preview": "vite preview",
    "api:gen": "swagger2openapi ../server/api/swagger.json -o src/api/openapi.json && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "lint": "biome check .",
    "lint:vue": "eslint .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.19.0",
    "element-plus": "^2.14.4",
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.102.0",
    "swagger2openapi": "^7.0.8",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-svg-component": "^0.12.6",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
