# 环境变量模板（复制为 .env.development / .env.production / .env.test 后填写实际值）
# 本文件可提交入库，真实的 .env.* 文件已被 .gitignore 忽略，请勿提交。

# 开发环境
VITE_APP_TITLE=web
API_PROXY_TARGET=http://localhost:9000

# 生产环境
# VITE_APP_TITLE=web
# API_PROXY_TARGET=https://your-prod-api.com

# 测试环境
# VITE_APP_TITLE=web
# API_PROXY_TARGET=https://your-test-api.com
